{
  "name": "context-security-scanner",
  "displayName": "Context Security Scanner",
  "description": "Context-aware code security scanner VS Code extension",
  "version": "0.1.0",
  "publisher": "security-team",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "activationEvents": [
    "onCommand:security-scanner.scanWorkspace",
    "onCommand:security-scanner.scanFile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "security-scanner.scanWorkspace",
        "title": "Security Scanner: Scan Workspace",
        "category": "Security Scanner",
        "icon": "$(shield)"
      },
      {
        "command": "security-scanner.scanFile",
        "title": "Security Scanner: Scan Current File",
        "category": "Security Scanner",
        "icon": "$(search)"
      },
      {
        "command": "security-scanner.openFinding",
        "title": "Open Finding"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "security-scanner-container",
          "title": "Security Scanner",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "security-scanner-container": [
        {
          "id": "securityFindings",
          "name": "Security Findings"
        }
      ],
      "explorer": [
        {
          "id": "securityFindingsExplorer",
          "name": "Security Findings"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "security-scanner.scanWorkspace",
          "when": "view == securityFindings || view == securityFindingsExplorer",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "security-scanner.scanFile",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Security Scanner",
      "properties": {
        "securityScanner.provider": {
          "type": "string",
          "enum": [
            "cli",
            "mock"
          ],
          "default": "cli",
          "description": "Findings provider: 'cli' executes Python scanner CLI, 'mock' reads mock findings JSON."
        },
        "securityScanner.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python executable (defaults to 'python')."
        },
        "securityScanner.scannerRoot": {
          "type": "string",
          "default": "",
          "description": "Root directory containing the 'scanner' package (defaults to the repository root)."
        },
        "securityScanner.autoScanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically trigger a context security scan when a file is saved."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./out/test/parse.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.3"
  }
}
